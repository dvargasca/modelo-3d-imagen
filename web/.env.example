# Copia este archivo a ".env" y rellena lo que necesites.
# Sin ninguna key, la app funciona en modo demo (proveedor "mock").

# Proveedor por defecto: mock | meshy | tripo
PROVIDER=mock

# Puerto del servidor (opcional).
PORT=3000

# API keys de los proveedores reales (solo la que vayas a usar):
# Meshy  -> https://www.meshy.ai  (Settings > API Keys)
MESHY_API_KEY=

# Tripo3D -> https://platform.tripo3d.ai
TRIPO_API_KEY=
