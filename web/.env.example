# Copia este archivo a ".env" y rellena lo que necesites.
# Sin ninguna key, la app funciona en modo demo (proveedor "mock").

# Proveedor por defecto: mock | triposr | meshy | tripo
PROVIDER=mock

# Puerto del servidor (opcional).
PORT=3000

# --- Opción GRATIS y LOCAL (sin API key, sin pagar, offline) ---------------
# "triposr" genera el modelo en TU máquina con TripoSR (open source). No necesita
# ninguna key: sólo tienes que arrancar el servicio Python de web/local-generator/
# (ver su README.md). Si lo corres en otra dirección/puerto, cámbialo aquí:
# TRIPOSR_URL=http://127.0.0.1:5001

# --- Opciones en la NUBE (plan gratis con créditos, pero necesitan cuenta+key) ---
# API keys de los proveedores reales (solo la que vayas a usar):
# Meshy  -> https://www.meshy.ai  (Settings > API Keys)
MESHY_API_KEY=

# Tripo3D -> https://platform.tripo3d.ai
TRIPO_API_KEY=
